aws_region   = "ap-southeast-2"
project_name = "cyber-risk-intelligence"
environment  = "dev"

container_image = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/cyber-risk-intelligence-dev-api:YOUR_GIT_SHA"

app_port         = 8000
desired_count    = 1
container_cpu    = 512
container_memory = 1024

allowed_cidr_blocks = ["0.0.0.0/0"]
health_check_path    = "/readyz"

database_s3_key      = "artifacts/analytics/cyber_risk.duckdb"
model_s3_key         = "artifacts/models/kev_horizon_ranker.joblib"
model_metrics_s3_key = "artifacts/reports/model_metrics.json"
